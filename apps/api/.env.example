# Copy to .env for local development. Never commit .env.
ENVIRONMENT=development
APP_NAME=Playlane
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
# Leave unset to run without a DB (health/db reports "unavailable").
# With `docker compose up -d` use the pooled URL for the app:
# DATABASE_URL=postgresql+asyncpg://tournament:tournament@localhost:5432/tournament
#
# DIRECT_URL is the non-pooled endpoint — only needed in production (Neon).
# Alembic migrations MUST use this to avoid PgBouncer prepared-statement conflicts.
# In dev/CI, DATABASE_URL is used as a fallback.
# DIRECT_URL=postgresql+asyncpg://...

# ── Auth (cookie-based JWT) ───────────────────────────────────────────────────
# In production JWT_SECRET must be a 32+ byte random secret (e.g. openssl rand -hex 32).
# COOKIE_SECURE=true is also required — both enforced by the startup config validator.
JWT_SECRET=dev-insecure-change-me
# Separate secret for storage URL HMAC signing — must be set independently in production.
# STORAGE_SIGNING_SECRET=
ACCESS_TOKEN_TTL=900           # 15m access token
REFRESH_TOKEN_TTL=2592000      # 30d server-side session lifetime
EMAIL_VERIFICATION_TOKEN_TTL=86400
PASSWORD_RESET_TOKEN_TTL=3600

# Cookies (dev defaults are HTTP-friendly; production values below)
COOKIE_SECURE=false            # MUST be true in production
COOKIE_SAMESITE=lax
# Set COOKIE_DOMAIN when frontend and API share a root domain (e.g. .playlane.live).
# Not needed when using the same-origin proxy pattern (recommended for MVP).
# COOKIE_DOMAIN=.example.com

# Brute-force throttle (in-process at MVP; Redis-backed when scaling to 2+ instances)
LOGIN_MAX_ATTEMPTS=10
LOGIN_ATTEMPT_WINDOW=900

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Endpoints return 501 until all three are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── Email ─────────────────────────────────────────────────────────────────────
# Without RESEND_API_KEY, emails are rendered to logs (LogEmailChannel).
# LogEmailChannel MUST NOT be used in production — startup validator enforces this.
# RESEND_API_KEY=
EMAIL_FROM=Playlane <noreply@localhost>

# ── Object storage ────────────────────────────────────────────────────────────
# Set all four R2_* core vars to switch from local disk to Cloudflare R2.
# R2 is required in production — startup validator enforces this when ENVIRONMENT=production.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT_URL=              # optional; defaults to https://<account>.r2.cloudflarestorage.com
# R2_PUBLIC_BASE_URL=           # public bucket URL or custom CDN domain for file downloads
STORAGE_LOCAL_DIR=.storage      # dev disk root (gitignored) — ignored when R2 is active
# STORAGE_PRESIGN_TTL=900
# STORAGE_MAX_UPLOAD_SIZE=52428800

# ── Background jobs ───────────────────────────────────────────────────────────
# The in-process outbox worker runs inside the API by default (single-instance MVP).
# Set WORKER_ENABLED=false on API replicas and run a dedicated worker instead.
WORKER_ENABLED=true
# WORKER_POLL_INTERVAL=2.0      # seconds between queue polls when idle
# WORKER_BATCH_SIZE=20          # outbox rows drained per cycle
# WORKER_MAX_ATTEMPTS=5         # dead-letter a job after this many failures
# OUTBOX_RETENTION_DAYS=7       # processed outbox rows older than this are purged

# ── Realtime (SSE) ────────────────────────────────────────────────────────────
# REALTIME_PING_INTERVAL=15     # SSE heartbeat seconds (keeps connections alive)
# REALTIME_MAX_QUEUE=100        # per-subscriber event buffer before drops

# ── Scaling seams (unused at MVP — set when adding a second instance) ─────────
# REDIS_URL=                    # Upstash Redis: enables distributed throttle + pub/sub + cache
# CACHE_DEFAULT_TTL=300

# ── Observability ─────────────────────────────────────────────────────────────
# SENTRY_DSN=
