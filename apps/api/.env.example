# Copy to .env for local development. Never commit .env.
ENVIRONMENT=development
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Database — leave unset to run without a DB (health/db reports "unavailable").
# With `docker compose up -d`, uncomment:
# DATABASE_URL=postgresql+asyncpg://tournament:tournament@localhost:5432/tournament

# Auth (cookie-based JWT). In production JWT_SECRET must be a real 32+ byte secret
# and COOKIE_SECURE=true (both enforced by the startup config validator).
JWT_SECRET=dev-insecure-change-me
# Separate secret for local-dev storage URL HMAC signing. Must be set in production.
# STORAGE_SIGNING_SECRET=
ACCESS_TOKEN_TTL=900          # 15m access token
REFRESH_TOKEN_TTL=2592000     # 30d server-side session lifetime
EMAIL_VERIFICATION_TOKEN_TTL=86400
PASSWORD_RESET_TOKEN_TTL=3600

# Cookies (dev defaults are HTTP-friendly; production hardening below)
COOKIE_SECURE=false           # MUST be true in production
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com   # set so app.* and api.* share auth cookies

# Brute-force throttle (in-process at MVP)
LOGIN_MAX_ATTEMPTS=10
LOGIN_ATTEMPT_WINDOW=900

# Google OAuth (endpoints return 501 until all three are set)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Email (LogEmailChannel renders to logs until an API key is set — must NOT be used in production)
# RESEND_API_KEY=
EMAIL_FROM=Playlane <noreply@localhost>

# Object storage — set all four R2_* to switch from local disk to Cloudflare R2.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT_URL=            # optional; defaults to https://<account>.r2.cloudflarestorage.com
# R2_PUBLIC_BASE_URL=         # public bucket / custom domain used for public file URLs
STORAGE_LOCAL_DIR=.storage    # dev disk root (gitignored) when R2 is not configured
# STORAGE_PRESIGN_TTL=900
# STORAGE_MAX_UPLOAD_SIZE=52428800

# Optional
# SENTRY_DSN=
