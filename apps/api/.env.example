# Copy to .env for local development. Never commit .env.
ENVIRONMENT=development
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Database — leave unset to run without a DB (health/db reports "unavailable").
# With `docker compose up -d`, uncomment:
# DATABASE_URL=postgresql+asyncpg://tournament:tournament@localhost:5432/tournament

# Auth (cookie-based JWT)
JWT_SECRET=dev-insecure-change-me
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# Optional
# SENTRY_DSN=
