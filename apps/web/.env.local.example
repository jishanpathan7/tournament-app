# Copy to .env.local for local development.
#
# Recommended: leave NEXT_PUBLIC_API_URL empty so the browser calls same-origin /api/v1
# (Next.js rewrites proxy to the backend). This keeps auth cookies working at localhost:3000.
# Server Components use API_INTERNAL_URL to reach the API directly.
NEXT_PUBLIC_API_URL=
API_INTERNAL_URL=http://127.0.0.1:8000
#
# Only set NEXT_PUBLIC_API_URL if you need direct cross-origin access (e.g. debugging CORS):
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
