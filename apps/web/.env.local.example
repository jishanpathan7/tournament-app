# Copy to .env.local for local development.
#
# Same-origin proxy strategy (recommended):
# Leave NEXT_PUBLIC_API_URL empty — the browser calls /api/v1 on the same origin
# and Next.js rewrites it to the backend (next.config.mjs). Auth cookies work
# at localhost:3000 without any CORS or COOKIE_DOMAIN configuration.
# Server Components use API_INTERNAL_URL to reach the API directly.
NEXT_PUBLIC_API_URL=
API_INTERNAL_URL=http://127.0.0.1:8000

# Public origin of this app — used for OG metadata, share links, and tournament
# registration URLs. Set to your production domain on Vercel.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Only set NEXT_PUBLIC_API_URL if you need direct cross-origin access (e.g. debugging CORS):
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
