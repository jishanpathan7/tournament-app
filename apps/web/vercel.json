{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "cd ../.. && yarn workspace web build",
  "installCommand": "cd ../.. && yarn install --frozen-lockfile",
  "outputDirectory": ".next",
  "ignoreCommand": "git diff HEAD^ HEAD --name-only | grep -q '^apps/web\\|^packages/' && exit 0 || exit 1"
}
